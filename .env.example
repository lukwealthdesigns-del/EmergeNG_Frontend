# Backend API base (include /api/v1). No secrets belong in VITE_ variables - everything here ships to the browser.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Mapbox PUBLIC token (pk.*) only. Never use a secret (sk.*) token here.
VITE_MAPBOX_PUBLIC_TOKEN=
# The backend CORS allow_headers does not include X-Sync-Token yet. Keep false until you add "X-Sync-Token" in app/main.py.
VITE_SEND_SYNC_TOKEN=false
